NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: enables the AI resume review feature (Anthropic Claude API)
ANTHROPIC_API_KEY=

# Optional: enables the credits/subscription checkout (Payfast)
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=

# Required for the scheduled auto-apply Cron Job (/api/cron/auto-apply).
# Generate a random value, set it here AND as a Vercel project env var, and
# store the same value in the cron_secrets table (key='auto_apply_cron_secret').
CRON_SECRET=

# Optional: enables auto-apply notification emails (Resend). Auto-apply still
# runs and logs in-app notifications without this — email just won't send.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional: enables the daily job sync across all 19 Adzuna-covered countries
# (/api/cron/adzuna-sync). App ID + key from https://developer.adzuna.com —
# free "Trial Access" plan.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional: enables the daily South Africa job sync from Google Jobs
# (/api/cron/serpapi-sync). API key from https://serpapi.com — free plan
# covers this (8 searches/day, ~240/month, under the 250/month free cap).
SERPAPI_API_KEY=
